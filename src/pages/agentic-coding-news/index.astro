---
import { Picture } from 'astro:assets';
import SiteHeader from '../../components/SiteHeader.astro';
import Layout from '../../layouts/Layout.astro';
import { formatDate, getNews, newsUrl } from '../../lib/agentic-coding-news';
import { workshopBlockHtml } from '../../lib/workshop-inline-ad';

const entries = await getNews();
---

<Layout
  title="Agentic Coding News von Nerds in Shirts"
  description="Aktuelle Entwicklungen und Best Practices rund um Agentic Coding, mit Quellen belegt, von Benjamin Klein und Roland Golla."
>
  <SiteHeader current="overview" />
  <div class="news-sheet max-w-5xl">
    <h1 class="news-title">Agentic Coding News</h1>

    {
      entries.length === 0 ? (
        <p class="news-empty">Die ersten Artikel erscheinen in Kürze.</p>
      ) : (
        <ol class="news-list">
          {entries.map((entry, index) => (
            <>
              <li class="news-item">
                {/* Same rendering as the article header; only the newest item may be the LCP image */}
                {entry.data.image && (
                  <a class="group block" href={newsUrl(entry)} tabindex="-1" aria-hidden="true">
                    <Picture
                      src={entry.data.image}
                      alt=""
                      formats={['avif', 'webp']}
                      layout="constrained"
                      width={944}
                      height={496}
                      sizes="(min-width: 64rem) 59rem, calc(100vw - 2rem)"
                      priority={index === 0}
                      class="mb-4 block h-auto w-full rounded-xl transition-opacity duration-200 group-hover:opacity-85"
                    />
                  </a>
                )}
                <p class="news-meta">
                  {entry.data.draft && <span class="news-draft">Entwurf</span>}
                  <time datetime={entry.data.pubDate.toISOString()}>{formatDate(entry.data.pubDate)}</time>
                  <span aria-hidden="true">·</span>
                  <span>
                    {[entry.data.quoteAuthor, entry.data.quotePosition, entry.data.quoteCompany].filter(Boolean).join(' · ')}
                  </span>
                </p>
                <h2 class="news-item__title">
                  <a href={newsUrl(entry)}>{entry.data.title}</a>
                </h2>
                <p class="news-item__tldr">{entry.data.tldr}</p>
              </li>
              {index === 0 && (
                <li class="news-list__ad" set:html={workshopBlockHtml(entry.data.workshop, 'uebersicht')} />
              )}
            </>
          ))}
        </ol>
      )
    }
  </div>
</Layout>
