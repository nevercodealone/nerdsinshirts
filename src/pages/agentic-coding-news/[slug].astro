---
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import AuthorBox from '../../components/news/ads/AuthorBox.astro';
import WorkshopMiniAd from '../../components/news/ads/WorkshopMiniAd.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Layout from '../../layouts/Layout.astro';
import {
  authors,
  domain,
  formatDate,
  getNews,
  hasInlineWorkshop,
  initials,
  readingMinutes,
  type NewsEntry,
} from '../../lib/agentic-coding-news';
import { defaultOgImage, type OgImage } from '../../lib/og-image';
import { workshopBlockHtml } from '../../lib/workshop-inline-ad';

export async function getStaticPaths() {
  const entries = await getNews();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: NewsEntry;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const author = authors[data.author];
const siteOrigin = Astro.site?.toString() ?? Astro.request.url;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
// Social crawlers get the untouched original (see [slug]-header.jpg.ts); the page renders <Picture>.
const ogImage: OgImage = data.image
  ? {
      src: `/agentic-coding-news/${entry.id}-header.jpg`,
      width: data.image.width,
      height: data.image.height,
      type: 'image/jpeg',
      alt: data.imageAlt ?? data.title,
    }
  : defaultOgImage;
const imageUrl = new URL(ogImage.src, siteOrigin).toString();
const modified = (data.updatedDate ?? data.pubDate).toISOString();
const workshopAfterBody = !hasInlineWorkshop(entry.rendered?.html);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  dateModified: modified,
  author: { '@type': 'Person', name: author.name, url: author.url },
  // The person the article reports on; the page author stays the real writer.
  citation: {
    '@type': 'CreativeWork',
    url: data.quoteUrl,
    author: {
      '@type': 'Person',
      name: data.quoteAuthor,
      ...(data.quotePosition && { jobTitle: data.quotePosition }),
      ...(data.quoteCompany && { worksFor: { '@type': 'Organization', name: data.quoteCompany } }),
    },
  },
  publisher: { '@type': 'Organization', name: 'Nerds in Shirts', url: siteOrigin },
  mainEntityOfPage: canonicalUrl,
  inLanguage: 'de-DE',
  image: { '@type': 'ImageObject', url: imageUrl, width: ogImage.width, height: ogImage.height },
  ...(data.tags.length > 0 && { keywords: data.tags.join(', ') }),
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: data.faq.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<Layout
  title={data.title}
  description={data.description}
  ogImage={ogImage}
  ogType="article"
>
  <Fragment slot="head">
    <meta name="author" content={author.name} />
    <meta property="article:published_time" content={data.pubDate.toISOString()} />
    <meta property="article:modified_time" content={modified} />
    <meta property="article:author" content={author.url} />
    <meta property="article:section" content="Agentic Coding News" />
    {data.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <SiteHeader current="article" />
  <article class="news-sheet max-w-5xl">

    {/* width = card content width (59rem); sizes must be explicit, Picture only copies it to <source> when passed */}
    {
      data.image && (
        <Picture
          src={data.image}
          alt={data.imageAlt ?? ''}
          formats={['avif', 'webp']}
          layout="constrained"
          width={944}
          height={496}
          sizes="(min-width: 64rem) 59rem, calc(100vw - 2rem)"
          priority
          class="mb-6 block h-auto w-full rounded-xl"
        />
      )
    }

    <p class="news-meta">
      {data.draft && <span class="news-draft">Entwurf</span>}
      <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingMinutes(entry.body)} Min. Lesezeit</span>
      {
        data.updatedDate && (
          <>
            <span aria-hidden="true">·</span>
            <span>
              aktualisiert am <time datetime={data.updatedDate.toISOString()}>{formatDate(data.updatedDate)}</time>
            </span>
          </>
        )
      }
    </p>

    <h1 class="news-title">{data.title}</h1>
    <p class="news-byline">
      <a href={data.quoteUrl} target="_blank" rel="noopener" class="text-primary hover:underline">
        {data.quoteAuthor}
      </a>
      {[data.quotePosition, data.quoteCompany].filter(Boolean).map((part) => <span> · {part}</span>)}
    </p>

    <section class="news-tldr" aria-label="Kurz gesagt">
      <p class="news-tldr__label">&gt; kurz gesagt</p>
      <p>{data.tldr}</p>
    </section>

    <WorkshopMiniAd />


    <div class="news-prose">
      <Content />
    </div>

    {workshopAfterBody && <Fragment set:html={workshopBlockHtml(data.workshop, 'artikel')} />}

    <figure class="news-quote">
      <blockquote>„{data.quoteText}“</blockquote>
      <figcaption>
        <span class="news-avatar" aria-hidden="true">{initials(data.quoteAuthor)}</span>
        <span>
          <span class="news-quote__name">{data.quoteAuthor}</span>
          {data.quoteRole && <span class="news-quote__role">{data.quoteRole}</span>}
          <a class="news-quote__link" href={data.quoteUrl} target="_blank" rel="noopener">
            Zum Original auf {domain(data.quoteUrl)}
          </a>
        </span>
      </figcaption>
    </figure>

    <section class="news-faq" aria-labelledby="faq-heading">
      <h2 id="faq-heading">Häufige Fragen</h2>
      {
        data.faq.map(({ question, answer }) => (
          <details>
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))
      }
    </section>

    <section class="news-sources" aria-labelledby="sources-heading">
      <h2 id="sources-heading">Quellen</h2>
      <ol>
        {
          data.sources.map((source) => (
            <li>
              <a href={source.url} target="_blank" rel="noopener">
                {source.title}
              </a>
              <span class="news-sources__meta">
                {[source.publisher, domain(source.url)].filter(Boolean).join(' · ')}
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    <AuthorBox author={data.author} />
  </article>
</Layout>
