---
import { NEWS_BASE } from '../lib/agentic-coding-news';

interface Props {
  current: 'home' | 'overview' | 'article';
}

const { current } = Astro.props;

const pill =
  'rounded-full px-3 py-1.5 font-label text-label-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';
const active = `${pill} bg-primary/15 font-bold text-primary ring-1 ring-primary/40`;
const inactive = `${pill} text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface`;
---

<header
  class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 relative z-10 mt-4 mb-6 w-full max-w-5xl rounded-2xl border border-surface-variant/40 bg-surface-container-low/90 px-4 py-3 shadow-lg shadow-surface-container-lowest/50 backdrop-blur-sm"
>
  <a href="/" aria-label="Zur Startseite" class="group inline-flex items-center gap-3 text-on-surface">
    <span
      class="inline-flex size-12 shrink-0 rounded-full bg-gradient-to-tr from-primary via-surface-container-high to-secondary p-0.5 transition duration-300 group-hover:scale-105 group-hover:shadow-lg group-hover:shadow-primary/40"
    >
      <img
        src="/nerds-in-shirts-gruen.png"
        alt=""
        width="48"
        height="48"
        class="size-full rounded-full bg-surface-container-lowest object-cover"
      />
    </span>
    <span class="font-headline text-lg font-bold transition-colors group-hover:text-primary">Nerds in Shirts</span>
  </a>

  <nav aria-label="Navigation" class="flex flex-wrap items-center gap-2">
    {
      current === 'home' ? (
        <span aria-current="page" class={active}>
          Startseite
        </span>
      ) : (
        <a href="/" class={inactive}>
          Startseite
        </a>
      )
    }
    {
      current === 'overview' ? (
        <span aria-current="page" class={active}>
          Agentic Coding News
        </span>
      ) : current === 'article' ? (
        <a href={NEWS_BASE} aria-current="true" class={active}>
          Agentic Coding News
        </a>
      ) : (
        <a href={NEWS_BASE} class={inactive}>
          Agentic Coding News
        </a>
      )
    }
  </nav>
</header>
