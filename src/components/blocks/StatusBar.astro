---
interface Props {
  text: string;
  separator?: string;
  highlight: string;
}

const { text, separator = '|', highlight } = Astro.props;
---

<div
  class="inline-flex items-center gap-space-sm px-space-md py-1.5 rounded-full bg-surface-container-high/95 backdrop-blur-sm shadow-lg shadow-surface-container-lowest/50 mb-space-lg group hover:bg-surface-container-highest hover:border-primary/40 border border-surface-variant/40 transition-all duration-300 hover:scale-[1.02] cursor-pointer"
>
  <span class="relative flex h-2.5 w-2.5 items-center justify-center">
    <span
      class="animate-radar absolute inline-flex h-3.5 w-3.5 rounded-full bg-primary opacity-60"></span>
    <span
      class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
    <span
      class="relative inline-flex rounded-full h-2 w-2 bg-primary shadow-[0_0_8px_#4be277]"></span>
  </span>
  <span class="font-label text-label-sm uppercase tracking-wider text-on-surface">
    {text} <span class="text-on-surface-variant px-1">{separator}</span>
    <span class="text-primary font-bold tracking-normal group-hover:text-primary-fixed transition-colors">{highlight}</span>
  </span>
</div>