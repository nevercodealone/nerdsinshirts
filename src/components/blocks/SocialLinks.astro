---
interface Props {
  title: string;
  links: { icon: string; label: string; handle: string; href: string }[];
}

const { title, links } = Astro.props;
---

<div class="w-full max-w-3xl pt-space-md border-t border-surface-variant/40">
  <span
    class="block font-label text-label-sm text-on-surface-variant uppercase tracking-widest mb-space-md text-center"
    >{title}</span
  >
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2.5">
    {
      links.map((link) => (
        <a
          href={link.href}
          target={link.href.startsWith('http') ? '_blank' : undefined}
          rel={link.href.startsWith('http') ? 'noreferrer' : undefined}
          class="tilt-card flex flex-col items-center justify-center gap-1.5 p-3 rounded-xl bg-surface-container-low hover:bg-surface-container-high hover:border-primary/40 border border-surface-variant/30 transition-all duration-300 group hover:-translate-y-1.5 hover:shadow-xl hover:shadow-primary/10"
        >
          <span class="material-symbols-outlined text-2xl text-secondary group-hover:scale-125 group-hover:text-primary transition-all duration-300">
            {link.icon}
          </span>
          <span class="font-label text-label-sm text-on-surface font-semibold group-hover:text-white transition-colors">
            {link.label}
          </span>
          <span class="font-label text-[10px] text-on-surface-variant group-hover:text-primary-fixed-dim transition-colors">
            {link.handle}
          </span>
        </a>
      ))
    }
  </div>
</div>